<!--
  SanerNow patch management rules for Wazuh.
  Events are sent by custom-sanernow.py through the analysisd socket and decoded
  by the built-in JSON decoder, so no custom decoder is needed.
  Rule ID range: 311000 - 311003
-->

<group name="sanernow,patch_management,">

  <rule id="311000" level="0">
    <decoded_as>json</decoded_as>
    <field name="integration">^sanernow$</field>
    <description>SanerNow: event received.</description>
  </rule>

  <rule id="311001" level="5">
    <if_sid>311000</if_sid>
    <field name="sanernow.event_type">^missing_patch$</field>
    <description>SanerNow: missing patch $(sanernow.patch_name) on $(sanernow.asset_hostname) - Severity: $(sanernow.severity).</description>
  </rule>

  <rule id="311002" level="10">
    <if_sid>311001</if_sid>
    <field name="sanernow.severity" type="pcre2">(?i)^(high|critical)$</field>
    <description>SanerNow: $(sanernow.severity) severity patch $(sanernow.patch_name) missing on $(sanernow.asset_hostname) ($(sanernow.cve_id)).</description>
  </rule>

  <rule id="311003" level="3">
    <if_sid>311000</if_sid>
    <field name="sanernow.event_type">^remediation$</field>
    <description>SanerNow: remediation of $(sanernow.patch_name) on $(sanernow.asset_hostname) - Status: $(sanernow.patch_status).</description>
  </rule>

</group>
